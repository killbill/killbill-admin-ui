# Legacy line: Java 11 + JRuby 9.4 + Tomcat 8.5  (standalone branch jruby9_old_branch)
PROFILE_NAME=java11
STANDALONE_BRANCH=jruby9_old_branch
# JRuby/JDK used to BUILD the WAR - mirrors .github/workflows/release.yml on that branch
# (jruby-9.4.15.0 + temurin 11). build.sh on that branch refuses JRuby < 9.4.11.0, so 9.4.10.0 cannot build it.
JRUBY_IMAGE=jruby:9.4.15.0-jdk11
# Runtime container the WAR is deployed to
TOMCAT_IMAGE=tomcat:8.5-jdk11
KB_PORT=18081
KAUI_PORT=18091
