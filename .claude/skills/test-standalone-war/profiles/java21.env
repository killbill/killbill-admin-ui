# Current line: Java 21 + JRuby 10 + Tomcat 11  (standalone branch master)
PROFILE_NAME=java21
STANDALONE_BRANCH=master
# JRuby/JDK used to BUILD the WAR - mirrors .github/workflows/release.yml on master (jruby-10.0.6.0 + temurin 21)
JRUBY_IMAGE=jruby:10.0.6.0-jdk21
TOMCAT_IMAGE=tomcat:11.0-jdk21
KB_PORT=18082
KAUI_PORT=18092
# JVM options added to the Kaui container. JRuby 10.0.x (and 10.1.0.0) copy the Rack env Hash handed to a JIT-compiled
# Rails::Engine#call, which stops session cookies after ~14 requests (killbill-admin-ui-standalone#131/#133).
# Same workaround as production (killbill/managed#175, killbill-cloud#346). Drop it once the WAR is on JRuby >= 10.1.1.
KAUI_EXTRA_JAVA_OPTS="-Djruby.jit.exclude=Rails::Engine#call"
