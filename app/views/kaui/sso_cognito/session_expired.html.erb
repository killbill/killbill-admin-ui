<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Session expired</title>
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f5f6f8; color: #212529; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
      .card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, .1); padding: 32px 40px; max-width: 460px; text-align: center; }
      h1 { font-size: 1.4rem; margin: 0 0 12px; }
      p { margin: 0; line-height: 1.5; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Your session has expired</h1>
      <p>Please reopen Kaui from the application you came from.</p>
    </div>
