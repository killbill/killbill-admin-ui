<% identifier = "Settings" %>

<%# Users signed in through the Cognito token exchange (no Kill Bill credentials) only see the admin screens when their Kill Bill permissions allow it (e.g. a *:* owner role) %>
<% show_admin_screens = !current_user&.cognito_principal? || can?(:manage, :all) %>

<% menu_items = [
  session[:tenant_id].present? ? { label: session["kb_tenant_name"], path: kaui_engine.admin_tenant_path(session[:tenant_id]), controller_suffix: "#{session[:tenant_id]}", icon_path: 'kaui/setting/account.svg' } : nil,
  show_admin_screens ? { label: 'Tenants', path: kaui_engine.admin_tenants_path, controller_suffix: 'admin_tenants', icon_path: 'kaui/setting/tenants.svg' } : nil,
  show_admin_screens ? { label: 'Users', path: kaui_engine.admin_allowed_users_path, controller_suffix: 'admin_allowed_users', icon_path: 'kaui/setting/users.svg' } : nil,
  show_admin_screens ? { label: 'Roles', path: kaui_engine.role_definitions_path, controller_suffix: 'role_definitions', icon_path: 'kaui/setting/users.svg' } : nil,
  { label: 'Tags', path: kaui_engine.tags_path, controller_suffix: 'tags', icon_path: 'kaui/setting/tags.svg' },
  { label: 'Tag Definitions', path: kaui_engine.tag_definitions_path, controller_suffix: 'tag_definitions', icon_path: 'kaui/setting/tag-definitions.svg' },
  { label: 'Custom Fields', path: kaui_engine.custom_fields_path, controller_suffix: 'custom_fields', icon_path: 'kaui/setting/custom-field.svg' }
].compact %>

<% if kpm_plugin_installed %>
  <% menu_items << { label: 'Plugins', path: "/kpm", controller_suffix: 'kpm', icon_path: 'kaui/setting/plugins.svg' } %>
  <% installed_plugin_names.each do |plugin| %>
    <% menu_items << { label: plugin[:name].humanize, path: plugin[:path], controller_suffix: plugin[:name].parameterize, icon_path: 'kaui/setting/plugins.svg' } %>
  <% end %>
<% end %>

<% if menu_items.present? %>
  <div class="setting-sidebar-area">
    <div class="container">
      <p><%= identifier %></p>

      <% menu_items.each do |item| %>
        <% css_class = request.path == item[:path] ? 'current' : 'non-current', "text-ellipsis" %>

        <%= link_to item[:path], class: css_class do %>
          <span class="icon">
            <%= image_tag(item[:icon_path], size: "20x20") %>
          </span>
          <%= item[:label] %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
